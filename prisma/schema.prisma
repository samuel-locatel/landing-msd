generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  state     String?
  cnpj      String?
  message   String?
  createdAt DateTime @default(now())
}
